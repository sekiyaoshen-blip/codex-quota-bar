#!/bin/bash
set -euo pipefail

SOURCE_URL="https://codeload.github.com/sekiyaoshen-blip/codex-quota-bar/tar.gz/refs/heads/main"
WORKDIR="$(/usr/bin/mktemp -d)"

cleanup() {
  /bin/rm -rf "$WORKDIR"
}
trap cleanup EXIT

ARCHIVE="$WORKDIR/source.tar.gz"
SOURCE_DIR="$WORKDIR/codex-quota-bar"

/usr/bin/curl \
  --fail \
  --location \
  --show-error \
  --connect-timeout 15 \
  --max-time 120 \
  --retry 2 \
  "$SOURCE_URL" \
  --output "$ARCHIVE"

/bin/mkdir "$SOURCE_DIR"
/usr/bin/env LC_ALL=C /usr/bin/tar \
  -xzf "$ARCHIVE" \
  --strip-components=1 \
  -C "$SOURCE_DIR"

"$SOURCE_DIR/scripts/install.sh"
